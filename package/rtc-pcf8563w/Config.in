config BR2_PACKAGE_RTC_PCF8563W
	bool "rtc-pcf8563w"
	depends on BR2_LINUX_KERNEL
	help
	  Seeed Studio fork of the PCF8563 RTC driver that also exposes
	  the RTC timer as a hardware watchdog.

	  https://github.com/Seeed-Studio/seeed-linux-dtoverlays

comment "rtc-pcf8563w needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL
